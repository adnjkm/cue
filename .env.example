# Nebius Token Factory. When set, every Nemotron call goes here. Server only, never NEXT_PUBLIC_.
NEBIUS_API_KEY=
# Hard spending cap in USD for Token Factory calls. Nebius budgets only send alerts, so Cue enforces this itself.
SPEND_CAP_USD=30

# Fallback when NEBIUS_API_KEY is empty: OpenRouter's free NVIDIA Nemotron models.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
