# Nebius Token Factory. When set, every Nemotron call goes here. Server only, never NEXT_PUBLIC_.
NEBIUS_API_KEY=
# Hard spending cap in USD for Token Factory calls. A value that is not a plain positive number turns paid calls off.
SPEND_CAP_USD=30

# Fallback when NEBIUS_API_KEY is empty: OpenRouter's free NVIDIA Nemotron models only (the ids are fixed in lib/ai/models.ts).
LLM_API_KEY=

# Required before any Vercel deploy: the shared spend ledger and client throttle. Without them, paid calls fail closed on Vercel.
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; Cue reads those too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# mock: deterministic answers with no key (refused when VERCEL_ENV=production). The walkthrough sets it.
# CUE_AI=mock

# 1 makes a browser's first visit start demo mode: the sample semester at Tuesday 10:12 of this week (docs/demo.md).
# NEXT_PUBLIC_CUE_DEMO=1
