# OpenAI-compatible provider. Defaults target OpenRouter's free NVIDIA Nemotron models.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Server only. Never prefix with NEXT_PUBLIC_.
LLM_API_KEY=
MODEL_PARSE=nvidia/nemotron-3.5-super-vl:free
MODEL_SOLVE=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_FAST=nvidia/nemotron-3.5-lightning:free

# Nebius Token Factory (same API shape; model ids differ, look them up in the Token Factory console):
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_PARSE=<token factory id for Nemotron 3.5 Super VL>
# MODEL_SOLVE=<token factory id for Nemotron 3 Ultra>
# MODEL_FAST=<token factory id for Nemotron 3.5 Lightning>
